# LLM Provider Configuration
# Options: "ollama", "gemini", or "openai_compatible"
LLM_PROVIDER=ollama

# Default model to use
# For Ollama: "gemma3:4b", "qwen3:4b", "mistral:7b", etc.
# For Gemini: "gemini-2.5-pro", "gemini-2.5-flash", etc.
# For DeepSeek/OpenAI-compatible: "deepseek-v4-flash", "deepseek-chat", etc.
DEFAULT_MODEL=gemma3:4b

# Google Gemini API Key (required if using Gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here


# OpenAI-compatible / DeepSeek API configuration
# For DeepSeek, use https://api.deepseek.com
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=your_deepseek_api_key_here

# Web demo expects DEEPSEEK_* names
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
