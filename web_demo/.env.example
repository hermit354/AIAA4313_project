# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional DeepSeek-compatible provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Optional Alibaba Cloud Bailian / DashScope OpenAI-compatible provider
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# The UI exposes the verified models directly:
# deepseek-v4-flash, qwen3-235b-a22b-instruct-2507, qwen3-vl-plus.
DASHSCOPE_MODEL=qwen3-235b-a22b-instruct-2507
